# Copia este archivo como .env (no se sube al repositorio) y cambia los valores.

# Base de datos
POSTGRES_USER=fst
POSTGRES_PASSWORD=cambia_esto
POSTGRES_DB=fst

# Correo. En desarrollo: MailHog (docker compose --profile dev). Dentro de Docker el host es
# "mailhog"; con el backend fuera de Docker, "localhost".
# Para Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_AUTH=true, SMTP_STARTTLS=true,
# SMTP_USER=tu cuenta y SMTP_PASSWORD=la contraseña de aplicación.
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_FROM=no-reply@fst.local

# Archivos
MAX_UPLOAD_MB=2048

# Worker (worker_fake): cada cuánto revisa la cola, hora de las tareas diarias (0-23) y minutos que
# espera un análisis en pausa antes de cancelarlo
WORKER_POLL_SECONDS=5
WORKER_DAILY_HOUR=3
PAUSE_TIMEOUT_MINUTES=5
WORKER_TZ=America/Mexico_City
# Solo del simulador: segundos que tarda cada etapa
WORKER_STAGE_SECONDS=3

# Disco: aviso al administrador y borrado de los videos más antiguos
DISK_ALERT_PERCENT=80
DISK_CLEANUP_PERCENT=90

# Autenticación. El backend empieza a leer estas variables cuando se implemente la autenticación.
# Firma de los tokens JWT: pon un valor largo y aleatorio, no el de ejemplo
JWT_SECRET=cambia_esto_por_un_valor_largo_y_aleatorio
# Vigencia de la sesión, en horas (168 = 7 días)
JWT_EXPIRES_HOURS=168
# Vigencia del enlace para restablecer la contraseña, en minutos
RESET_LINK_MINUTES=60
# Vigencia, en minutos, del token de solo lectura que el frontend pone en ?vt= para reproducir el
# video de un análisis
VIDEO_TOKEN_MINUTES=120

# Primer administrador (se crea al arrancar si no existe). Pon valores reales, no los de ejemplo.
ADMIN_ID=
ADMIN_NOMBRE=
ADMIN_APELLIDOS=
ADMIN_CORREO=
ADMIN_PASSWORD=
