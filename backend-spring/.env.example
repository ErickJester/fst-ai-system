# Copia este archivo como .env (no se sube al repositorio) y cambia los valores.

# Base de datos
POSTGRES_USER=fst
POSTGRES_PASSWORD=cambia_esto
POSTGRES_DB=fst

# Correo. En desarrollo: MailHog (docker compose --profile dev). Dentro de Docker el host es
# "mailhog"; con el backend fuera de Docker, "localhost".
# Para Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_AUTH=true, SMTP_STARTTLS=true,
# SMTP_USER=tu cuenta y SMTP_PASSWORD=la contraseña de aplicación.
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_FROM=no-reply@fst.local

# Archivos
MAX_UPLOAD_MB=2048

# --- Todavía no se usan (secciones de la guía que faltan) ---
# Autenticación
# JWT_SECRET=cambia_esto_por_un_valor_largo_y_aleatorio
# JWT_EXPIRES_HOURS=168
# RESET_LINK_MINUTES=60
# Disco (las tareas programadas las hace el worker)
# DISK_ALERT_PERCENT=80
# DISK_CLEANUP_PERCENT=90
# Primer administrador; pon valores reales, no los de ejemplo
# ADMIN_ID=
# ADMIN_NOMBRE=
# ADMIN_APELLIDOS=
# ADMIN_CORREO=
# ADMIN_PASSWORD=
