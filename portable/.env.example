# ===========================================================================
#  Configuracion del Sistema FST (version portable)
#
#  Este archivo se llama ".env". Lo crea iniciar.bat la primera vez, copiando este ejemplo.
#  Solo tienes que llenar la parte de la cuenta del administrador (mas abajo).
#  Escribe cada valor sin comillas y sin espacios al final.
# ===========================================================================

# --- Base de datos -------------------------------------------------------
# El nombre y la clave de la base que usa el sistema por dentro. No necesitas
# cambiar nada: iniciar.bat genera una clave larga y aleatoria la primera vez (al ver
# la palabra GENERAR), igual que la llave de seguridad. Si prefieres una propia,
# escribela AHORA, antes del primer inicio: despues de crear los datos ya no se puede
# cambiar sin borrarlos. Si ya tenias el sistema instalado (con su base), no la
# cambies nunca.
POSTGRES_USER=fst
POSTGRES_PASSWORD=GENERAR
POSTGRES_DB=fst

# --- Seguridad -----------------------------------------------------------
# Llave con la que se firman las sesiones. NO la llenes: iniciar.bat la
# genera solo, la primera vez, al ver la palabra GENERAR.
JWT_SECRET=GENERAR
# Cuantas horas dura una sesion abierta (168 = 7 dias).
JWT_EXPIRES_HOURS=168

# --- Tu cuenta de administrador (LLENA ESTO) -----------------------------
# Esta es la cuenta con la que entras la primera vez. La contrasena es
# TEMPORAL: el sistema te pide cambiarla en cuanto entres.
#   ADMIN_ID        tu boleta o numero de empleado (maximo 10 caracteres)
#   ADMIN_NOMBRE    tu nombre
#   ADMIN_APELLIDOS tus apellidos
#   ADMIN_CORREO    tu correo (es el usuario con el que entras)
#   ADMIN_PASSWORD  una contrasena temporal (la que quieras, minimo 8 caracteres)
ADMIN_ID=
ADMIN_NOMBRE=
ADMIN_APELLIDOS=
ADMIN_CORREO=
ADMIN_PASSWORD=

# --- Videos --------------------------------------------------------------
# Tamano maximo de un video, en MB. No lo cambies: la pagina acepta hasta 2048.
MAX_UPLOAD_MB=2048

# --- Direccion ------------------------------------------------------------
# El sistema se abre en http://localhost:8088 desde esta PC. Si ese numero ya lo usa
# otro programa de tu PC, pon aqui otro (por ejemplo 8090).
PUERTO_WEB=8088
# Desde OTRAS PCs de la red se abre con la direccion de esta PC: su nombre
# (http://NOMBRE-DE-LA-PC:8088) o su IP (http://192.168.x.y:8088). Esa direccion es la
# que va en los correos de recuperar contrasena. Si la dejas vacia, iniciar.bat usa el
# nombre de la PC. Escribela completa (con http:// y el puerto) solo si quieres otra,
# por ejemplo la IP fija: http://192.168.1.50:8088
# Conviene que esta PC tenga IP fija (o usar su nombre), porque la IP puede cambiar.
# Para que otras PCs puedan entrar hay que ejecutar abrir_red.bat UNA vez como administrador.
DIRECCION_WEB=

# --- Hora ----------------------------------------------------------------
# Zona horaria para las tareas diarias y los avisos.
WORKER_TZ=America/Mexico_City

# --- Modo desarrollador ---------------------------------------------------
# true: muestra herramientas de desarrollo (cronometro y tiempos de cada analisis, banner con la version).
# false para el uso normal del laboratorio. Para cambiarlo basta editar esta linea y reiniciar
# (desde la carpeta portable: docker compose -f ..\docker-compose.yml --env-file .env up -d --no-deps api worker);
# no hay que reconstruir nada.
MODO_DESARROLLADOR=false

# --- Nombre de esta computadora (OPCIONAL) -------------------------------
# Nombre para reconocer esta computadora en los reportes, por ejemplo Laptop Erick.
# Cada analisis guarda cuanto tardo y en que equipo; asi se pueden comparar los
# tiempos entre computadoras. Si lo dejas vacio, se usa el modelo del procesador.
EQUIPO_NOMBRE=

# --- Correo --------------------------------------------------------------
# El sistema manda correos por dos motivos: los AVISOS de los analisis (terminado, error,
# pausa, cancelado, disco) y la RECUPERACION DE CONTRASENA. Sin esta parte, los avisos
# salen solo en la campanita de la pagina y nadie puede recuperar su contrasena por
# correo. Llenala con UNA de estas dos opciones; escribe cada valor sin comillas y sin
# espacios al final. Despues ejecuta iniciar.bat y comprueba con probar_correo.bat
# (manda un correo de prueba a tu cuenta de administrador).
#
# Opcion 1: el servidor de correo de tu institucion (pide los datos a quien lo administra).
#   SMTP_HOST=smtp.tuinstitucion.mx   SMTP_PORT=587 (o 25 / 465 segun el servidor)
#   SMTP_USER y SMTP_PASSWORD si el servidor pide usuario; SMTP_AUTH=true si pide usuario;
#   SMTP_STARTTLS=true si el servidor usa cifrado STARTTLS (lo normal en el 587).
# Opcion 2: una cuenta de Gmail con CONTRASENA DE APLICACION (no la contrasena normal: en
#   tu cuenta de Google, Seguridad, activa la verificacion en dos pasos y crea una
#   "contrasena de aplicacion"):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=tucuenta@gmail.com
#   SMTP_PASSWORD=la-contrasena-de-aplicacion-de-16-letras
#   SMTP_AUTH=true
#   SMTP_STARTTLS=true
#   SMTP_FROM=tucuenta@gmail.com   (la misma cuenta: Gmail cambia otro remitente)
# Con SMTP_HOST vacio no se manda ningun correo (iniciar.bat te lo avisa).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_FROM=
