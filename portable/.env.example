# ===========================================================================
#  Configuracion del Sistema FST (version portable)
#
#  Este archivo se llama ".env". Lo crea iniciar.bat la primera vez, copiando este ejemplo.
#  Solo tienes que llenar la parte de la cuenta del administrador (mas abajo).
#  Escribe cada valor sin comillas y sin espacios al final.
# ===========================================================================

# --- Base de datos -------------------------------------------------------
# El nombre y la clave de la base que usa el sistema por dentro. No necesitas
# cambiarlos, pero si quieres, pon una clave propia ANTES del primer inicio:
# despues de crear los datos ya no se puede cambiar sin borrarlos.
POSTGRES_USER=fst
POSTGRES_PASSWORD=fst
POSTGRES_DB=fst

# --- Seguridad -----------------------------------------------------------
# Llave con la que se firman las sesiones. NO la llenes: iniciar.bat la
# genera solo, la primera vez, al ver la palabra GENERAR.
JWT_SECRET=GENERAR
# Cuantas horas dura una sesion abierta (168 = 7 dias).
JWT_EXPIRES_HOURS=168

# --- Tu cuenta de administrador (LLENA ESTO) -----------------------------
# Esta es la cuenta con la que entras la primera vez. La contrasena es
# TEMPORAL: el sistema te pide cambiarla en cuanto entres.
#   ADMIN_ID        tu boleta o numero de empleado (maximo 10 caracteres)
#   ADMIN_NOMBRE    tu nombre
#   ADMIN_APELLIDOS tus apellidos
#   ADMIN_CORREO    tu correo (es el usuario con el que entras)
#   ADMIN_PASSWORD  una contrasena temporal (la que quieras, minimo 8 caracteres)
ADMIN_ID=
ADMIN_NOMBRE=
ADMIN_APELLIDOS=
ADMIN_CORREO=
ADMIN_PASSWORD=

# --- Videos --------------------------------------------------------------
# Tamano maximo de un video, en MB. No lo cambies: la pagina acepta hasta 2048.
MAX_UPLOAD_MB=2048

# --- Direccion ------------------------------------------------------------
# El sistema se abre en http://localhost:8088 . Si ese numero ya lo usa otro
# programa de tu PC, pon aqui otro (por ejemplo 8090).
PUERTO_WEB=8088

# --- Hora ----------------------------------------------------------------
# Zona horaria para las tareas diarias y los avisos.
WORKER_TZ=America/Mexico_City

# --- Correo (OPCIONAL) ---------------------------------------------------
# El sistema funciona SIN correo: los avisos salen en la campanita de la
# pagina. Si algun dia quieres que tambien lleguen por correo, quita el # de
# estas lineas y llenalas. Si no, dejalas asi.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_AUTH=true
# SMTP_STARTTLS=true
# SMTP_FROM=
