# Variables del frontend (Vite). Copia este archivo como .env para cambiarlas en desarrollo;
# en el contenedor de producción se pasan como argumentos de compilación (Dockerfile.prod).

# true (por defecto): datos de ejemplo del navegador, sin backend («modo demo»).
# false: todas las pantallas llaman a la API de VITE_API_BASE.
VITE_USE_MOCKS=true

# Dirección de la API. En desarrollo, el backend local; en producción, /api (nginx la reenvía).
VITE_API_BASE=http://localhost:8000

# Tamaño máximo de un video en MB (MAX_UPLOAD_MB del backend y client_max_body_size de nginx).
VITE_MAX_UPLOAD_MB=2048
