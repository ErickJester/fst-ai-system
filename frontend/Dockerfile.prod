# Imagen de producción del frontend: compila la app y la sirve con nginx.
# (El Dockerfile de al lado es el de desarrollo: servidor de Vite con recarga en caliente.)
#
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up --build
#
# Las variables VITE_* se graban al compilar, así que van como argumentos de construcción.

# ── 1. Compilar ────────────────────────────────────────────────────────────────
FROM node:20-alpine AS compilar
WORKDIR /app

# true: datos de ejemplo (modo demo). false: la app llama al backend.
ARG VITE_USE_MOCKS=true
# Ruta del backend vista desde el navegador; nginx la reenvía al contenedor «api».
ARG VITE_API_BASE=/api
ENV VITE_USE_MOCKS=$VITE_USE_MOCKS VITE_API_BASE=$VITE_API_BASE

COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

# ── 2. Servir ──────────────────────────────────────────────────────────────────
FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=compilar /app/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s CMD wget -qO- http://127.0.0.1/salud || exit 1
